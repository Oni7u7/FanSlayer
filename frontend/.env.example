# Copia este archivo a .env y llena los valores.
# Vite solo expone al navegador las variables con prefijo VITE_.
# No pongas aquí nada secreto: todo VITE_* termina en el bundle público.

# App ID de tu app en el dashboard de Privy
VITE_PRIVY_APP_ID=
# Dirección del contrato FanSlayerArtists desplegado en Monad testnet
VITE_CONTRACT_ADDRESS=
